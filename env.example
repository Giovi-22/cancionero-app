# Copiá este archivo a `.env` (que debe estar en .gitignore).
# Después de cambiarlo, reiniciá Metro con: npx expo start -c

# Muestra las herramientas de debug (ChordPro, modo depuración, etc.).
# Solo tiene efecto en builds de desarrollo (__DEV__); en release se ignora.
EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=true
